@b new-calendar-widget {
    font-family: var(--w-widget_font-family, 'Roboto', sans-serif);
    width: 100%;
    height: 100%;

    @e container {
        display: flex;
        flex-direction: column;
        width: 100%;
        height: 100%;
        padding: 1rem;
    }

    @e presets {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        margin-bottom: 1rem;
    }

    @e presets-buttons {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

    @e preset-button {
        cursor: pointer;
        border: 1px solid #e0e0e0;
        transition: all 0.2s ease;

        &:hover {
            background-color: var(--w-preset-button-hover-background, #e0e0e0);
        }

        &.active {
            background-color: var(--w-preset-button-active-background, rgba(3, 169, 244, 0.1));
            border-color: rgba(3, 169, 244, 0.8);
        }
    }

    @e presets-dropdown {
        select {
            cursor: pointer;
            border: 1px solid #e0e0e0;
            width: 100%;
            max-width: 300px;
        }
    }

    @e drilldown {
        display: flex;
        gap: 0.5rem;
        margin-bottom: 1rem;
        flex-wrap: wrap;
    }

    @e drilldown-button {
        cursor: pointer;
        border: 1px solid #e0e0e0;
        padding: 0.5rem 1rem;
        transition: all 0.2s ease;

        &:hover {
            background-color: #f5f5f5;
        }

        &.active {
            background-color: rgba(3, 169, 244, 0.1);
            border-color: rgba(3, 169, 244, 0.8);
        }
    }

    @e separate-input {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    @e date-inputs {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
    }

    @e input-group {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;

        label {
            font-weight: 500;
            font-size: 0.875rem;
        }

        input {
            border: 1px solid #e0e0e0;
            padding: 0.5rem;
            border-radius: 4px;
            min-width: 150px;

            &:focus {
                outline: none;
                border-color: rgba(3, 169, 244, 0.8);
            }
        }
    }

    @e calendars-row {
        display: flex;
        gap: 2rem;
        flex-wrap: wrap;
    }

    @e calendar-wrapper {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        flex: 1;
        min-width: 300px;
    }

    @e calendar-label {
        font-weight: 500;
        font-size: 1rem;
    }

    @e single-calendar {
        width: 100%;
        height: 100%;
    }

    @e chart-container {
        width: 100%;
        min-height: 400px;
        height: 500px;
    }
}


